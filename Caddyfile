{
    # Global options - works for both environments
    email {$LETSENCRYPT_EMAIL}
}

# N8N
{$N8N_HOSTNAME} {
    # For domains, Caddy will automatically use Let's Encrypt
    # For localhost/port addresses, HTTPS won't be enabled
    reverse_proxy n8n:5678
}

# Langfuse
{$LANGFUSE_HOSTNAME} {
    reverse_proxy langfuse-web:3000
}

# Supabase
{$SUPABASE_HOSTNAME} {
    reverse_proxy kong:8000
}

# Grafana
{$GRAFANA_HOSTNAME} {
    reverse_proxy grafana:3000
}

# Prometheus
{$PROMETHEUS_HOSTNAME} {
    basic_auth {
        {$PROMETHEUS_USERNAME} {$PROMETHEUS_PASSWORD_HASH}
    }
    reverse_proxy prometheus:9090
}

# Portainer
{$PORTAINER_HOSTNAME} {
    reverse_proxy portainer:9000
}

# Postgresus
{$POSTGRESUS_HOSTNAME} {
    reverse_proxy postgresus:4005
}

# Multica (AI agents workspace) - single-origin layout
{$MULTICA_HOSTNAME} {
    # Private instance: keep it out of search engines
    header X-Robots-Tag "noindex, nofollow, noarchive"
    handle /robots.txt {
        respond `User-agent: *
Disallow: /` 200
    }

    # WebSocket goes straight to the backend (Next.js rewrites don't proxy upgrades)
    @multica_ws path /ws /ws/*
    handle @multica_ws {
        reverse_proxy multica-backend:8080 {
            flush_interval -1
        }
    }

    # Everything else -> frontend (it proxies /api, /auth, /uploads, /v1 to the backend)
    reverse_proxy multica-frontend:3000
}

# Welcome Page (Post-install dashboard)
{$WELCOME_HOSTNAME} {
    basic_auth {
        {$WELCOME_USERNAME} {$WELCOME_PASSWORD_HASH}
    }
    root * /srv/welcome
    file_server
    try_files {path} /index.html
}

import /etc/caddy/addons/*.conf
