FROM alpine:3.22 AS ffmpeg-stage
RUN apk add --no-cache ffmpeg

FROM n8nio/n8n:stable

USER root
COPY --from=ffmpeg-stage /usr/bin/ffmpeg /usr/bin/ffmpeg
COPY --from=ffmpeg-stage /usr/bin/ffprobe /usr/bin/ffprobe
COPY --from=ffmpeg-stage /usr/lib/libavcodec* /usr/lib/
COPY --from=ffmpeg-stage /usr/lib/libavdevice* /usr/lib/
COPY --from=ffmpeg-stage /usr/lib/libavfilter* /usr/lib/
COPY --from=ffmpeg-stage /usr/lib/libavformat* /usr/lib/
COPY --from=ffmpeg-stage /usr/lib/libavutil* /usr/lib/
COPY --from=ffmpeg-stage /usr/lib/libpostproc* /usr/lib/
COPY --from=ffmpeg-stage /usr/lib/libswresample* /usr/lib/
COPY --from=ffmpeg-stage /usr/lib/libswscale* /usr/lib/
USER node
